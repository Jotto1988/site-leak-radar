{
  "manifest_version": 3,
  "name": "Site Leak Radar",
  "version": "1.2.0",
  "description": "Passively detects leaked secrets (incl. exposed source maps), generates footprint dorks, and injects custom HTTP headers.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Site Leak Radar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"]
    }
  ]
}
